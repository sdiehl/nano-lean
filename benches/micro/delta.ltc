def g997 : Nat -> Nat := fun (x : Nat) => g996 x
def g998 : Nat -> Nat := fun (x : Nat) => g997 x
def g999 : Nat -> Nat := fun (x : Nat) => g998 x
def g1000 : Nat -> Nat := fun (x : Nat) => g999 x
theorem same_height : Eq.{1} Nat (f1000 5) (g1000 5) := Eq.refl.{1} Nat (g1000 5)
theorem mixed_height : Eq.{1} Nat (f1000 5) (g500 5) := Eq.refl.{1} Nat (g500 5)
theorem args_unfold : Eq.{1} Nat (f1000 (Nat.add 2 2)) (f1000 (g1000 3)) := Eq.refl.{1} Nat (f1000 (g1000 3))
theorem to_literal : Eq.{1} Nat (f1000 (f1000 (g1000 0))) (3) := Eq.refl.{1} Nat (3)
